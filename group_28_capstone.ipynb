   "source": [
    "# Exclude rows missing either BMI or age group.\n",
    "recorded_bmi = df.dropna(subset=[\"bmi\", \"age_group\"])\n",
    "\n",
    "# Group the remaining patients by age group and calculate BMI mean and median.\n",
    "bmi_by_age_group = (\n",
    "    recorded_bmi\n",
    "    .groupby(\"age_group\", observed=False)[\"bmi\"]\n",
    "    .agg(mean_bmi=\"mean\", median_bmi=\"median\")\n",
    ")\n",
    "\n",
    "# Display the summary table.\n",
    "display(bmi_by_age_group)"
   ]
