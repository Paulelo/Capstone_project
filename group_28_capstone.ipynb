        "# Calculate each age group's median using only rows with recorded BMI.\n",
        "# Convert the categorical age groups to strings to make the mapping consistent.\n",
        "bmi_medians_by_age = (\n",
        "    df.dropna(subset=[\"bmi\", \"age_group\"])\n",
        "      .assign(age_group=lambda data: data[\"age_group\"].astype(str))\n",
        "      .groupby(\"age_group\")[\"bmi\"]\n",
        "      .median()\n",
        ")\n",
        "\n",
        "# Look up the matching age-group median for each row.\n",
        "bmi_estimates = df[\"age_group\"].astype(str).map(bmi_medians_by_age)\n",
        "\n",
        "# Ensure BMI is a float column, then fill only its missing values with the estimates.\n",
        "df[\"bmi\"] = df[\"bmi\"].astype(\"float64\").fillna(bmi_estimates)\n",
        "\n",
        "# Check whether any BMI values remain missing.\n",
        "print(\"BMI values still missing:\", df[\"bmi\"].isna().sum())"
      ]
