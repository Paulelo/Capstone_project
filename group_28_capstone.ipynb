      "source": [
        "# Select only numeric columns from the dataframe.\n",
        "numeric_data = df.select_dtypes(include=\"number\")\n",
        "\n",
        "# Calculate correlations with BMI, then remove BMI's correlation with itself.\n",
        "bmi_correlations = numeric_data.corr()[\"bmi\"].drop(\"bmi\")\n",
        "\n",
        "# Sort the results from strongest to weakest by absolute correlation.\n",
        "bmi_correlations = bmi_correlations.reindex(\n",
        "    bmi_correlations.abs().sort_values(ascending=False).index\n",
        ")\n",
        "\n",
        "# Display the correlations in a labeled table.\n",
        "display(bmi_correlations.to_frame(\"correlation_with_bmi\"))"
