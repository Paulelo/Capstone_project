    "# Select patients whose BMI is missing.\n",
    "missing_bmi = df[df[\"bmi\"].isna()]\n",
    "\n",
    "# Count those with average glucose at least 150 and at most 150.\n",
    "count_150_and_above = (missing_bmi[\"avg_glucose_level\"] >= 150).sum()\n",
    "count_150_and_below = (missing_bmi[\"avg_glucose_level\"] <= 150).sum()\n",
    "\n",
    "# Print both counts. A glucose value of exactly 150 is included in both.\n",
    "print(\"BMI missing, glucose >= 150:\", count_150_and_above)\n",
    "print(\"BMI missing, glucose <= 150:\", count_150_and_below)"
